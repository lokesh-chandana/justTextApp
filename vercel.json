{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/whatsapp-callback/?",
      "dest": "/api/whatsapp_callback.php?action=WhatsAppCallback"
    },
    {
      "src": "/login\\.php",
      "dest": "/api/login.php"
    },
    {
      "src": "/index\\.php",
      "dest": "/api/index.php"
    },
    {
      "src": "/login/?",
      "dest": "/api/login.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
