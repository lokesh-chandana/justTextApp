RewriteEngine On

# Default document (Vercel uses api/; Apache mirrors that)
DirectoryIndex api/index.php

# Hide sensitive / internal files
<FilesMatch "^(config|control_security)\.php$">
  Require all denied
</FilesMatch>

# Block direct access to query logs and local sql
RewriteRule ^supabase(/|$) - [F,L]

# Block hidden files (e.g. .env if placed here)
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

# Pretty / local aliases → api handlers (same as vercel.json routes)
RewriteRule ^whatsapp-callback/?$ api/whatsapp_callback.php?action=WhatsAppCallback [L,QSA]
RewriteRule ^login\.php$ api/login.php [L,QSA]
RewriteRule ^index\.php$ api/index.php [L,QSA]
RewriteRule ^login/?$ api/login.php [L,QSA]
